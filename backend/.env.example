# Server
PORT=5000
NODE_ENV=development

# Frontend URL allowed by CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,http://localhost:5176

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/hotelyashdeep

# Admin JWT
JWT_SECRET=replace_with_a_long_random_admin_secret
JWT_EXPIRES_IN=7d

# Customer JWT (dedicated secret for customer authentication)
CUSTOMER_JWT_SECRET=replace_with_a_long_random_customer_secret

# Brevo SMTP / Transactional Email
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_login
BREVO_SMTP_PASSWORD=your_brevo_smtp_master_key
BREVO_FROM_EMAIL=hello@hotelyashdeep.in
BREVO_FROM_NAME=Hotel Yashdeep

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
